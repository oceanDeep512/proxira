---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface-2">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-3 max-w-xs text-[14px] leading-relaxed text-fg-soft">
        轻量化实时请求代理工具：本地转发 + 可视化观测面板。
      </p>
      <p class="eyebrow mt-4">Transparent proxy, visible.</p>
    </div>

    <div>
      <p class="eyebrow mb-3">产品</p>
      <ul class="space-y-2 text-[14px] text-fg-soft">
        <li><a class="hover:text-fg" href="/guide">用法</a></li>
        <li><a class="hover:text-fg" href="/changelog">更新日志</a></li>
        <li>
          <a
            class="hover:text-fg"
            href="https://www.npmjs.com/package/proxira"
            target="_blank"
            rel="noopener">npm</a
          >
        </li>
      </ul>
    </div>

    <div>
      <p class="eyebrow mb-3">开源</p>
      <ul class="space-y-2 text-[14px] text-fg-soft">
        <li>
          <a
            class="hover:text-fg"
            href="https://github.com/oceanDeep512/proxira"
            target="_blank"
            rel="noopener">GitHub</a
          >
        </li>
        <li>
          <a
            class="hover:text-fg"
            href="https://github.com/oceanDeep512/proxira/issues"
            target="_blank"
            rel="noopener">问题反馈</a
          >
        </li>
        <li>
          <a
            class="hover:text-fg"
            href="https://github.com/oceanDeep512/proxira/blob/main/README.md"
            target="_blank"
            rel="noopener">README</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap flex flex-wrap items-center justify-between gap-3 border-t border-line py-5 text-[13px] text-fg-dim">
    <p>MIT License · © {year} oceandeep512</p>
    <p>本地开发调试工具，请勿直接暴露公网</p>
  </div>
</footer>
