---
import Logo from "./Logo.astro";

const navItems = [
  { href: "/", label: "首页" },
  { href: "/guide", label: "用法" },
  { href: "/changelog", label: "更新日志" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-surface/85 backdrop-blur-md"
>
  <div class="wrap flex items-center justify-between gap-4 py-3.5">
    <a href="/" class="flex items-center" aria-label="Proxira 首页">
      <Logo />
    </a>

    <nav class="flex items-center gap-1 text-[14px]">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-sm px-3 py-1.5 transition-colors duration-150",
              isActive(item.href)
                ? "text-fg"
                : "text-fg-soft hover:text-fg",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }

      <a
        href="https://github.com/oceanDeep512/proxira"
        target="_blank"
        rel="noopener"
        class="ml-1 hidden items-center gap-1.5 rounded-sm px-3 py-1.5 text-fg-soft transition-colors duration-150 hover:text-fg sm:inline-flex"
      >
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        GitHub
      </a>

      <button
        type="button"
        id="theme-toggle"
        class="ml-1 flex size-8 items-center justify-center rounded-sm border border-line text-fg-soft transition-colors duration-150 hover:border-accent hover:text-accent"
        aria-label="切换深浅主题"
        title="切换深浅主题"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon="sun">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" stroke-linecap="round"></path>
        </svg>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon="moon">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
