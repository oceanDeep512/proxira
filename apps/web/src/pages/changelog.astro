---
import Base from "../layouts/Base.astro";
import { releases, type ChangeKind } from "../data/changelog";

const kindClass: Record<ChangeKind, string> = {
  新增: "border-accent text-accent",
  变更: "border-beam text-beam",
  修复: "border-line-strong text-fg-soft",
};
---

<Base
  title="更新日志 · Proxira"
  description="Proxira 的版本记录：每次发版新增了什么、改了什么、修了什么。"
>
  <div class="wrap section-sm pt-16 sm:pt-20">
    <p class="eyebrow">Changelog</p>
    <h1 class="mt-3 text-[36px] sm:text-[42px]">更新日志</h1>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-fg-soft">
      每次发版记录新增、变更与修复。版本号遵循语义化版本，配置结构变更时会做自动迁移。
    </p>
  </div>

  <div class="wrap pb-24">
    <ol class="space-y-12">
      {
        releases.map((release) => (
          <li class="grid gap-6 lg:grid-cols-[160px_minmax(0,1fr)] lg:gap-10">
            <div class="lg:sticky lg:top-24 lg:self-start">
              <p class="font-mono text-[22px] font-medium tracking-tight">
                v{release.version}
              </p>
              <p class="mt-1 font-mono text-[12px] text-fg-dim">{release.date}</p>
            </div>

            <div class="card">
              <p class="text-[15px] leading-relaxed text-fg-soft">
                {release.summary}
              </p>

              <div class="mt-6 space-y-5">
                {release.groups.map((group) => (
                  <div>
                    <span
                      class:list={[
                        "inline-flex rounded-full border px-2.5 py-0.5 font-mono text-[11px]",
                        kindClass[group.kind],
                      ]}
                    >
                      {group.kind}
                    </span>
                    <ul class="mt-3 space-y-2 text-[15px] leading-relaxed text-fg-soft">
                      {group.items.map((item) => (
                        <li class="flex gap-3">
                          <span
                            class="mt-[9px] size-1.5 flex-none rounded-full"
                            style="background:var(--px-accent)"
                            aria-hidden="true"
                          />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="mt-14 text-[14px] text-fg-dim">
      更早的版本见
      <a
        class="text-accent-strong underline underline-offset-3"
        href="https://github.com/oceanDeep512/proxira/commits/main"
        target="_blank"
        rel="noopener">GitHub 提交历史</a
      >。
    </p>
  </div>
</Base>
