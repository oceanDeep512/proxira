---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* 首屏前定主题：跟随系统，用户手动切换过就以选择为准，避免闪白 */}
    <script is:inline>
      (() => {
        const el = document.documentElement;
        try {
          const saved = localStorage.getItem("px-theme");
          el.dataset.theme =
            saved ||
            (matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
        } catch {
          el.dataset.theme = "light";
        }
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // 主题切换 + 代码块复制：整站只有这两处需要 JS
      const toggle = document.getElementById("theme-toggle");
      toggle?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("px-theme", next);
        } catch {
          /* 隐私模式下写不进去也不影响本次切换 */
        }
      });

      const writeClipboard = async (text: string) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // http 且非 localhost 时没有 clipboard，退回旧接口
          const area = document.createElement("textarea");
          area.value = text;
          area.style.position = "fixed";
          area.style.opacity = "0";
          document.body.appendChild(area);
          area.select();
          const ok = document.execCommand("copy");
          area.remove();
          return ok;
        }
      };

      const flash = (btn: HTMLElement, text: string) => {
        const original = btn.dataset.label || btn.textContent || "复制";
        btn.dataset.label = original;
        btn.textContent = text;
        setTimeout(() => {
          btn.textContent = original;
        }, 1400);
      };

      // Hero / 命令块：按钮自带 data-copy
      document.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const ok = await writeClipboard(btn.dataset.copy || "");
          flash(btn, ok ? "已复制" : "复制失败");
        });
      });

      // Markdown 代码块：包一层容器再挂按钮，避免污染 pre 的结构
      document.querySelectorAll(".prose pre").forEach((pre) => {
        if (pre.parentElement?.classList.contains("code-wrap")) return;
        const wrap = document.createElement("div");
        wrap.className = "code-wrap";
        wrap.style.position = "relative";
        pre.replaceWith(wrap);
        wrap.appendChild(pre);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.textContent = "复制";
        btn.style.cssText =
          "position:absolute;top:8px;right:8px;background:var(--px-surface-2)";
        btn.addEventListener("click", async () => {
          const ok = await writeClipboard(pre.textContent || "");
          flash(btn, ok ? "已复制" : "复制失败");
        });
        wrap.appendChild(btn);
      });
    </script>
  </body>
</html>
