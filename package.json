{
  "name": "proxira-monorepo",
  "version": "1.0.0",
  "description": "Proxira monorepo：轻量化实时请求代理工具（后端代理 + Web 控制面板）。根目录不发布，发布主体是 apps/getway。",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "dev:server": "pnpm --filter ./apps/getway dev",
    "dev:web": "pnpm --filter @proxira/dashboard dev",
    "build": "pnpm --filter ./apps/getway build:pkg",
    "start": "pnpm run build && pnpm --filter ./apps/getway start",
    "serve": "pnpm --filter ./apps/getway start",
    "start:cli": "pnpm --filter ./apps/getway start:cli",
    "test": "pnpm --filter ./apps/getway test",
    "pack:app": "pnpm --filter ./apps/getway pack:pkg",
    "publish:npm": "pnpm --filter ./apps/getway publish:pkg",
    "release": "pnpm --filter ./apps/getway version:patch && pnpm run publish:npm",
    "release:minor": "pnpm --filter ./apps/getway version:minor && pnpm run publish:npm",
    "release:major": "pnpm --filter ./apps/getway version:major && pnpm run publish:npm"
  },
  "keywords": [],
  "author": "oceandeep512",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
